#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER 1
#define GAMING 2
#define GAME_FN 3

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
  &kp TAB  &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
  &kp ESC  &kp A &kp S &kp D &kp F &kp G    &kp H &kp J  &kp K     &kp L   &kp SEMI &kp RET
  &kp LGUI &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
           &kp LALT &kp LCTRL &kp LSHIFT    &kp SPACE &kp RGUI &mo LOWER
      >;
      display-name = "DEFAULT";
    };
    lower_layer {
      bindings = <
  &kp C_BRI_UP &kp N1     &kp N2       &kp N3       &kp N4       &kp N5          &kp N6     &kp N7       &kp N8       &kp N9     &kp N0           &trans
  &kp C_BRI_DN &kp MINUS  &kp EQUAL    &kp LBKT     &kp RBKT     &kp GRAVE       &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT  &kp BSLH         &kp APOS
  &trans       &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3    &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PLAY_PAUSE &trans
                                                  &tog GAMING &trans &trans    &trans &trans &trans
      >;
      display-name = "LOWER";
    };
    gaming_layer {
      bindings = <
  &kp TAB    &kp T &kp Q &kp W &kp E &kp R    &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
  &kp ESC    &kp G &kp A &kp S &kp D &kp F    &kp H &kp J  &kp K     &kp L   &kp SEMI &kp RET
  &kp LSHIFT &kp B &kp Z &kp X &kp C &kp V    &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                     &kp ESC &kp LCTRL &kp SPACE    &kp SPACE &kp RGUI &mo GAME_FN
      >;
      display-name = "GAMING";
    };
    game_fn_layer {
      bindings = <
  &kp C_BRI_UP &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6     &kp N7       &kp N8       &kp N9     &kp N0           &trans
  &kp C_BRI_DN &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp GRAVE    &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT  &kp BSLH         &kp APOS
  &trans       &trans    &trans    &trans    &trans    &trans       &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PLAY_PAUSE &trans
                                                   &tog GAMING &trans &trans    &trans &trans &trans
      >;
      display-name = "GAME FN";
    };
    extra1 { status = "reserved"; };
    extra2 { status = "reserved"; };
    extra3 { status = "reserved"; };
    extra4 { status = "reserved"; };
    extra5 { status = "reserved"; };
  };
};
